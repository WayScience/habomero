POSTGRES_DB=omero
POSTGRES_USER=omero
POSTGRES_PASSWORD=omero-change-me
OMERO_ROOT_PASSWORD=omero-root-change-me
OMERO_SERVER_TAG=latest
OMERO_WEB_TAG=latest
OMERO_WEB_PORT=4080
# OMERO server session timing (milliseconds)
# Default 1 hour inactivity timeout; allow up to 24h idle requests.
OMERO_SESSIONS_TIMEOUT_MS=3600000
OMERO_SESSIONS_MAX_IDLE_MS=86400000
# 0 means no max time-to-live limit.
OMERO_SESSIONS_MAX_TTL_MS=0
# Keep web login session across browser restarts.
OMERO_WEB_SESSION_EXPIRE_AT_BROWSER_CLOSE=false
OMERO_SCAN_DIR=./data/inbox
